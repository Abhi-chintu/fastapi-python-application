pipeline {
    agent any
    
    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '637423245256'

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        GATEWAY_REPO = "${ECR_REGISTRY}/demo/gateway"
        PRODUCTS_REPO = "${ECR_REGISTRY}/demo/product"

        IMAGE_TAG = "${BUILD_NUMBER}"
    }
    stages {
        stage('Checkout'){
            steps {
                git branch: 'jenkins', url: 'https://github.com/Abhi-chintu/fastapi-python-application.git'
            }
        }
        stage('Static Analysis'){
            steps {
                echo 'Running Gitleaks security scan...'

        sh '''
            gitleaks git \
                --log-opts="--all" \
                --report-format json \
                --report-path gitleaks-report.json \
                --redact=100 \
                --exit-code 1 \
                .
        '''
            }
        }
        stage('UT Coverage'){
            steps{
                echo 'Running Pylint for Gateway and Products'

        sh '''
            /opt/pylint-venv/bin/pylint gateway \
                --output-format=text \
                --exit-zero > pylint-gateway-report.txt

            /opt/pylint-venv/bin/pylint products \
                --output-format=text \
                --exit-zero > pylint-products-report.txt

            echo "Pylint analysis completed"

            cat pylint-gateway-report.txt
            cat pylint-products-report.txt
        '''
            }
        }
        stage('Docker Build'){
            steps {
                sh '''
                    docker build -t $GATEWAY_REPO:$IMAGE_TAG \
                        -f gateway/Dockerfile .

                    docker build -t $PRODUCTS_REPO:$IMAGE_TAG \
                        -f products/Dockerfile ./products 
                '''
            }
        }
        stage('Docker Push'){
            steps{
                sh '''
                aws ecr get-login-password --region $AWS_REGION |
                    docker login --username AWS \
                        --password-stdin $ECR_REGISTRY
                        
                    docker push $GATEWAY_REPO:$IMAGE_TAG
                    docker push $PRODUCTS_REPO:$IMAGE_TAG
                '''
            }
        }
    }
}