
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '637423245256'

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        GATEWAY_REPO = "${ECR_REGISTRY}/demo/gateway"
        PRODUCTS_REPO = "${ECR_REGISTRY}/demo/product"

        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm

                sh '''
                    echo "Branch: $BRANCH_NAME"
                    echo "PR ID: $CHANGE_ID"
                    git log -1 --oneline
                '''
            }
        }

        stage('Static Analysis') {
            steps {
                echo 'Running Gitleaks'

                sh '''
                    gitleaks git \
                        --report-format json \
                        --report-path gitleaks-report.json \
                        --redact=100 \
                        --exit-code 1 \
                        .
                '''
            }
        }

        stage('UT Coverage') {
            steps {
                echo 'Running Pylint'

                sh '''
                    /opt/pylint-venv/bin/pylint gateway \
                        --exit-zero \
                        > pylint-gateway-report.txt

                    /opt/pylint-venv/bin/pylint products \
                        --exit-zero \
                        > pylint-products-report.txt

                    cat pylint-gateway-report.txt
                    cat pylint-products-report.txt
                '''
            }
        }

        stage('Docker Build') {
            when {
                allOf {
                    branch 'jenkins'
                    not {
                        changeRequest()
                    }
                }
            }

            steps {
                echo 'Building Docker images'

                sh '''
                    docker build \
                        -t $GATEWAY_REPO:$IMAGE_TAG \
                        -f gateway/Dockerfile .

                    docker build \
                        -t $PRODUCTS_REPO:$IMAGE_TAG \
                        -f products/Dockerfile ./products
                '''
            }
        }

        stage('Docker Push') {
            when {
                allOf {
                    branch 'jenkins'
                    not {
                        changeRequest()
                    }
                }
            }

            steps {
                echo 'Pushing images to AWS ECR'

                sh '''
                    set -e

                    aws ecr get-login-password \
                        --region $AWS_REGION |
                    docker login \
                        --username AWS \
                        --password-stdin $ECR_REGISTRY

                    docker push $GATEWAY_REPO:$IMAGE_TAG
                    docker push $PRODUCTS_REPO:$IMAGE_TAG
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'gitleaks-report.json,pylint-*-report.txt',
                allowEmptyArchive: true
            )
        }

        success {
            echo 'Pipeline completed successfully'
        }

        failure {
            echo 'Pipeline failed'
        }
    }
}
