
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '637423245256'

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        GATEWAY_REPO = "${ECR_REGISTRY}/demo/gateway"
        PRODUCTS_REPO = "${ECR_REGISTRY}/demo/product"

    }

    stages {

        
        stage('Determine Build Mode') {
            steps {
                script {
                    env.BUILD_MODE = 'SKIP'

                    def eventType = (env.x_github_event ?: '').trim()
                    def action = (env.event_action ?: '').trim()
                    def repo = (env.repo_name ?: '').trim()
                    def base = (env.pr_base ?: '').trim()
                    def ref = (env.push_ref ?: '').trim()

                    echo "===== WEBHOOK DEBUG ====="
                    echo "Event: ${eventType}"
                    echo "Action: ${action}"
                    echo "Repository: ${repo}"
                    echo "PR Base: ${base}"
                    echo "PR SHA: ${env.pr_sha ?: 'NOT_SET'}"
                    echo "Push Ref: ${ref}"
                    echo "========================="

                    if (repo == 'Abhi-chintu/fastapi-python-application') {

                        if (eventType == 'pull_request' &&
                            action in ['opened', 'reopened', 'synchronize'] &&
                            base == 'jenkins') {

                            env.BUILD_MODE = 'PR_VALIDATION'

                        } else if (eventType == 'push' &&
                                ref == 'refs/heads/jenkins') {

                            env.BUILD_MODE = 'MERGED_BRANCH'
                        }

                        else if (
                            eventType == 'push' &&
                            ref ==~ /^refs\/tags\/v(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$/
                        ) {
                            env.BUILD_MODE = 'RELEASE'
                            env.IMAGE_TAG = ref.substring('refs/tags/'.length())
                        }
                    }

                    echo "BUILD_MODE = ${env.BUILD_MODE}"
                }
            }
        }


        
        stage('Checkout') {
            when {
                expression {
                    env.BUILD_MODE != 'SKIP'
                }
            }

            steps {
                script {
                    def branch = ''

                    if (env.BUILD_MODE == 'PR_VALIDATION') {
                        branch = env.pr_sha

                    } else if (env.BUILD_MODE == 'MERGED_BRANCH') {
                        branch = env.push_sha

                    } else if (env.BUILD_MODE == 'RELEASE') {
                        branch = "refs/tags/${env.IMAGE_TAG}"
                    }

                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: branch]],
                        userRemoteConfigs: [[
                            url: 'https://github.com/Abhi-chintu/fastapi-python-application.git',
                            refspec: '+refs/heads/*:refs/remotes/origin/* ' +
                                    '+refs/pull/*/head:refs/remotes/origin/pr/* ' +
                                    '+refs/tags/*:refs/tags/*'
                        ]]
                    ])

                    echo "Checked out: ${branch}"
                }
            }
        }


        stage('Load Functions') {
            when {
                expression {
                    env.BUILD_MODE != 'SKIP'
                }
            }

            steps {
                script {
                    pipelineUtils = load 'jenkins/pipeline.groovy'
                }
            }
        }

        stage('Gitleaks') {
            when {
                expression {
                    env.BUILD_MODE != 'SKIP'
                }
            }

            steps {
                script {
                    pipelineUtils.runGitleaks()
                }
            }
        }

        stage('Pylint') {
            when {
                expression {
                    env.BUILD_MODE != 'SKIP'
                }
            }

            steps {
                script {
                    pipelineUtils.runPylint()
                }
            }
        }

        stage('Docker Build') {
            when {
                expression {
                    env.BUILD_MODE == 'RELEASE'
                }
            }

            steps {
                script {
                    pipelineUtils.buildDocker()
                }
            }
        }

        stage('Docker Push') {
            when {
                expression {
                    env.BUILD_MODE == 'RELEASE'
                }
            }

            steps {
                script {
                    pipelineUtils.pushDocker()
                }
            }
        }
    }

    
    post {
        always {
            archiveArtifacts(
                artifacts: 'gitleaks-report.json,pylint-*-report.txt',
                allowEmptyArchive: true
            )
        }

        success {
            emailext(
                to: 'your-email@example.com',
                subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """Jenkins build successful.

    Job: ${env.JOB_NAME}
    Build: ${env.BUILD_NUMBER}
    Result: SUCCESS

    Console: ${env.BUILD_URL}console
    """
            )
        }

        failure {
            emailext(
                to: 'your-email@example.com',
                subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """Jenkins build failed.

    Job: ${env.JOB_NAME}
    Build: ${env.BUILD_NUMBER}
    Result: FAILURE

    Console: ${env.BUILD_URL}console
    """,
                attachLog: true
            )
        }
    }
}
