def pipelineHelper

pipeline {
    agent any

    environment {
        AWS_REGION = 'ap-south-1'
        ECR_REGISTRY = '123456789012.dkr.ecr.ap-south-1.amazonaws.com'
        REPOSITORY_URL = 'https://github.com/Abhi-chintu/fastapi-python-application.git'
    }

    stages {
        stage('Prepare') {
            steps {
                checkout scm
                script {
                    pipelineHelper = load 'jenkins/pipeline.groovy'
                    env.RUN_CI = pipelineHelper.shouldRunCI(
                        env.github_event,
                        env.action,
                        env.base_ref,
                        env.head_sha,
                        env.ref,
                        env.review_state,
                        env.review_commit,
                        env.commit_sha
                    ) ? 'true' : 'false'
                    env.RUN_PUBLISH = pipelineHelper.shouldPublish(
                        env.github_event,
                        env.action,
                        env.base_ref,
                        env.head_sha,
                        env.review_state,
                        env.review_commit
                    ) ? 'true' : 'false'
                    env.CHECKOUT_SHA = pipelineHelper.checkoutSha(
                        env.github_event,
                        env.commit_sha,
                        env.head_sha
                    )
                    if (env.RUN_PUBLISH == 'true') {
                        env.IMAGE_TAG = pipelineHelper.imageTag(
                            env.pr_number,
                            env.head_sha
                        )
                    } else {
                        env.IMAGE_TAG = ''
                    }
                    if (env.RUN_CI != 'true') {
                        echo 'Ignoring webhook: no CI or publish action is required.'
                    }
                }
            }
        }

        stage('Checkout') {
            when {
                environment name: 'RUN_CI', value: 'true'
            }
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: env.CHECKOUT_SHA]],
                    userRemoteConfigs: [[url: env.REPOSITORY_URL]]
                ])
            }
        }

        stage('Install CI dependencies') {
            when {
                environment name: 'RUN_CI', value: 'true'
            }
            steps {
                sh 'make -f jenkins/Makefile ci-setup'
            }
        }

        stage('Lint') {
            when {
                environment name: 'RUN_CI', value: 'true'
            }
            steps {
                sh 'make -f jenkins/Makefile lint'
            }
        }

        stage('Static analysis') {
            when {
                environment name: 'RUN_CI', value: 'true'
            }
            steps {
                sh 'make -f jenkins/Makefile static-analysis'
            }
        }

        stage('Code coverage') {
            when {
                environment name: 'RUN_CI', value: 'true'
            }
            steps {
                sh 'make -f jenkins/Makefile coverage'
            }
        }

        stage('Docker build') {
            when {
                environment name: 'RUN_PUBLISH', value: 'true'
            }
            steps {
                script {
                    pipelineHelper.buildImages(env.ECR_REGISTRY, env.IMAGE_TAG)
                }
            }
        }

        stage('Docker push') {
            when {
                environment name: 'RUN_PUBLISH', value: 'true'
            }
            steps {
                script {
                    pipelineHelper.pushImages(
                        env.AWS_REGION,
                        env.ECR_REGISTRY,
                        env.IMAGE_TAG,
                        'aws-ecr-credentials'
                    )
                }
            }
        }
    }
}
