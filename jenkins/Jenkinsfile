
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '637423245256'
        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        GATEWAY_REPO = "${ECR_REGISTRY}/demo/gateway"
        PRODUCTS_REPO = "${ECR_REGISTRY}/demo/product"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {      
        stage('Checkout') {
            when {
                expression {
                    env.BUILD_MODE != 'SKIP'
                }
            }

            steps {
                script {
                    def repoUrl =
                        'https://github.com/Abhi-chintu/fastapi-python-application.git'

                    if (env.BUILD_MODE == 'PR_VALIDATION') {
                        echo "Checking out PR commit: ${env.pr_sha}"

                        if (!(env.pr_sha ==~ /^[0-9a-fA-F]{40}$/)) {
                            error('Invalid PR SHA')
                        }

                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: env.pr_sha]],
                            userRemoteConfigs: [[
                                url: repoUrl,
                                refspec: '+refs/pull/*/head:refs/remotes/origin/pr/*'
                            ]],
                            extensions: [
                                [$class: 'CleanBeforeCheckout']
                            ]
                        ])

                        def actualSha = sh(
                            script: 'git rev-parse HEAD',
                            returnStdout: true
                        ).trim()

                        if (!actualSha.equalsIgnoreCase(env.pr_sha)) {
                            error("PR checkout SHA mismatch")
                        }

                        echo "Verified PR commit: ${actualSha}"

                    } else if (env.BUILD_MODE == 'MERGED_BRANCH') {
                        error(
                            'Trusted branch checkout and deployment ' +
                            'authorization are not configured yet.'
                        )
                    }
                }
            }
        }


        stage('Load Pipeline Functions') {
            when {
                expression {
                    env.BUILD_MODE != 'SKIP'
                }
            }
            steps {
                script {
                    pipelineUtils = load 'jenkins/pipeline.groovy'
                }
            }
        }

        stage('Static Analysis') {
            when {
                expression {
                    env.BUILD_MODE in [
                        'PR_VALIDATION',
                        'MERGED_BRANCH'
                    ]
                }
            }
            steps {
                script {
                    pipelineUtils.runGitleaks()
                }
            }
        }

        stage('UT Coverage') {
            when {
                expression {
                    env.BUILD_MODE in [
                        'PR_VALIDATION',
                        'MERGED_BRANCH'
                    ]
                }
            }
            steps {
                script {
                    pipelineUtils.runPylint()
                }
            }
        }

        stage('Docker Build') {
            when {
                expression {
                    env.BUILD_MODE == 'MERGED_BRANCH'
                }
            }
            steps {
                script {
                    pipelineUtils.buildDocker()
                }
            }
        }

        stage('Docker Push') {
            when {
                expression {
                    env.BUILD_MODE == 'MERGED_BRANCH'
                }
            }
            steps {
                script {
                    pipelineUtils.pushDocker()
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'gitleaks-report.json,pylint-*-report.txt',
                allowEmptyArchive: true
            )
        }

        success {
            echo 'Pipeline completed successfully'
        }

        failure {
            echo 'Pipeline failed'
        }
    }
}
