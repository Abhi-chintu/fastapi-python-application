
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '637423245256'

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        GATEWAY_REPO = "${ECR_REGISTRY}/demo/gateway"
        PRODUCTS_REPO = "${ECR_REGISTRY}/demo/product"

        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Determine Build Mode') {
            steps {
                script {
                    env.BUILD_MODE = 'SKIP'

                    def eventType = env.x_github_event ?: ''

                    echo "===== WEBHOOK DEBUG ====="
                    echo "github_event = ${eventType ?: 'NOT_SET'}"
                    echo "event_action = ${env.event_action ?: 'NOT_SET'}"
                    echo "repo_name = ${env.repo_name ?: 'NOT_SET'}"
                    echo "pr_base = ${env.pr_base ?: 'NOT_SET'}"
                    echo "pr_sha = ${env.pr_sha ?: 'NOT_SET'}"
                    echo "push_ref = ${env.push_ref ?: 'NOT_SET'}"
                    echo "push_sha = ${env.push_sha ?: 'NOT_SET'}"

                    if (env.repo_name ==
                        'Abhi-chintu/fastapi-python-application') {

                        if (
                            eventType == 'pull_request' &&
                            env.event_action in [
                                'opened',
                                'reopened',
                                'synchronize'
                            ] &&
                            env.pr_base == 'jenkins'
                        ) {
                            env.BUILD_MODE = 'PR_VALIDATION'

                        } else if (
                            eventType == 'push' &&
                            env.push_ref == 'refs/heads/jenkins'
                        ) {
                            env.BUILD_MODE = 'MERGED_BRANCH'
                        }
                    }

                    echo "BUILD_MODE = ${env.BUILD_MODE}"
                    echo "========================="
                }
            }
        }

        stage('Checkout') {
            when {
                expression {
                    env.BUILD_MODE in [
                        'PR_VALIDATION',
                        'MERGED_BRANCH'
                    ]
                }
            }

            steps {
                script {
                    def repoUrl =
                        'https://github.com/Abhi-chintu/fastapi-python-application.git'

                    def expectedSha = ''

                    if (env.BUILD_MODE == 'PR_VALIDATION') {
                        expectedSha = env.pr_sha ?: ''

                        echo "Checking out PR commit: ${expectedSha}"

                        if (!(expectedSha ==~ /^[0-9a-fA-F]{40}$/)) {
                            error('Invalid PR SHA')
                        }

                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: expectedSha]],
                            userRemoteConfigs: [[
                                url: repoUrl,
                                refspec: '+refs/pull/*/head:refs/remotes/origin/pr/*'
                            ]],
                            extensions: [
                                [$class: 'CleanBeforeCheckout']
                            ]
                        ])

                    } else if (env.BUILD_MODE == 'MERGED_BRANCH') {
                        // Deployment remains blocked until the
                        // trusted branch and agent are configured.
                        error(
                            'Trusted merged-branch deployment is not enabled yet.'
                        )
                    }

                    def actualSha = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    if (!actualSha.equalsIgnoreCase(expectedSha)) {
                        error(
                            "Checkout SHA mismatch. " +
                            "Expected ${expectedSha}, got ${actualSha}"
                        )
                    }

                    echo "Verified checkout SHA: ${actualSha}"
                }
            }
        }

        stage('Load Pipeline Functions') {
            when {
                expression {
                    env.BUILD_MODE in [
                        'PR_VALIDATION',
                        'MERGED_BRANCH'
                    ]
                }
            }

            steps {
                script {
                    pipelineUtils = load 'jenkins/pipeline.groovy'
                }
            }
        }

        stage('Static Analysis') {
            when {
                expression {
                    env.BUILD_MODE in [
                        'PR_VALIDATION',
                        'MERGED_BRANCH'
                    ]
                }
            }

            steps {
                script {
                    pipelineUtils.runGitleaks()
                }
            }
        }

        stage('UT Coverage') {
            when {
                expression {
                    env.BUILD_MODE in [
                        'PR_VALIDATION',
                        'MERGED_BRANCH'
                    ]
                }
            }

            steps {
                script {
                    pipelineUtils.runPylint()
                }
            }
        }

        stage('Docker Build') {
            when {
                expression {
                    env.BUILD_MODE == 'MERGED_BRANCH'
                }
            }

            steps {
                script {
                    pipelineUtils.buildDocker()
                }
            }
        }

        stage('Docker Push') {
            when {
                expression {
                    env.BUILD_MODE == 'MERGED_BRANCH'
                }
            }

            steps {
                script {
                    pipelineUtils.pushDocker()
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'gitleaks-report.json,pylint-*-report.txt',
                allowEmptyArchive: true
            )
        }

        success {
            echo 'Pipeline completed successfully'
        }

        failure {
            echo 'Pipeline failed'
        }
    }
}
