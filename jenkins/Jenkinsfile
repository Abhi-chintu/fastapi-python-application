
pipeline {
    agent none

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '637423245256'

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        GATEWAY_REPO = "${ECR_REGISTRY}/demo/gateway"
        PRODUCTS_REPO = "${ECR_REGISTRY}/demo/product"

        BUILD_MODE = 'SKIP'
        DEPLOY_ENABLED = 'false'
    }

    stages {

        stage('Determine Build Mode') {
            agent { label 'pr-validation' }

            steps {
                script {
                    def eventType = env.x_github_event ?: ''
                    env.BUILD_MODE = 'SKIP'

                    echo "===== WEBHOOK DEBUG ====="
                    echo "github_event = ${eventType ?: 'NOT_SET'}"
                    echo "event_action = ${env.event_action ?: 'NOT_SET'}"
                    echo "repo_name = ${env.repo_name ?: 'NOT_SET'}"
                    echo "pr_base = ${env.pr_base ?: 'NOT_SET'}"
                    echo "pr_sha = ${env.pr_sha ?: 'NOT_SET'}"
                    echo "push_ref = ${env.push_ref ?: 'NOT_SET'}"
                    echo "push_sha = ${env.push_sha ?: 'NOT_SET'}"

                    if (env.repo_name ==
                        'Abhi-chintu/fastapi-python-application') {

                        if (
                            eventType == 'pull_request' &&
                            env.event_action in [
                                'opened',
                                'reopened',
                                'synchronize'
                            ] &&
                            env.pr_base == 'jenkins'
                        ) {
                            env.BUILD_MODE = 'PR_VALIDATION'

                        } else if (
                            eventType == 'push' &&
                            env.push_ref == 'refs/heads/jenkins'
                        ) {
                            env.BUILD_MODE = 'MERGED_BRANCH'
                        }
                    }

                    echo "BUILD_MODE = ${env.BUILD_MODE}"
                    echo "========================="
                }
            }
        }

        stage('PR Validation') {
            when {
                expression {
                    env.BUILD_MODE == 'PR_VALIDATION'
                }
            }

            agent { label 'pr-validation' }

            stages {
                stage('Checkout PR') {
                    steps {
                        script {
                            def expectedSha = env.pr_sha ?: ''

                            if (!(expectedSha ==~ /^[0-9a-fA-F]{40}$/)) {
                                error('Invalid PR SHA')
                            }

                            checkout([
                                $class: 'GitSCM',
                                branches: [[name: expectedSha]],
                                userRemoteConfigs: [[
                                    url: 'https://github.com/Abhi-chintu/fastapi-python-application.git',
                                    refspec: '+refs/pull/*/head:refs/remotes/origin/pr/*'
                                ]],
                                extensions: [
                                    [$class: 'CleanBeforeCheckout']
                                ]
                            ])

                            def actualSha = sh(
                                script: 'git rev-parse HEAD',
                                returnStdout: true
                            ).trim()

                            if (!actualSha.equalsIgnoreCase(expectedSha)) {
                                error('PR checkout SHA mismatch')
                            }

                            echo "Verified PR SHA: ${actualSha}"
                        }
                    }
                }

                stage('Load PR Functions') {
                    steps {
                        script {
                            def utils = load 'jenkins/pipeline.groovy'
                            utils.runGitleaks()
                            utils.runPylint()
                        }
                    }
                }
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'gitleaks-report.json,pylint-*-report.txt',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('Merged Branch Build') {
            when {
                expression {
                    env.BUILD_MODE == 'MERGED_BRANCH'
                }
            }

            agent { label 'trusted-deploy' }

            stages {
                stage('Verify Deployment Authorization') {
                    steps {
                        script {
                            if (env.DEPLOY_ENABLED != 'true') {
                                error(
                                    'Deployment disabled. Configure trusted ' +
                                    'agent and webhook authentication first.'
                                )
                            }

                            def expectedSha = env.push_sha ?: ''

                            if (!(expectedSha ==~ /^[0-9a-fA-F]{40}$/)) {
                                error('Invalid push SHA')
                            }

                            env.VERIFIED_SHA = expectedSha
                            env.IMAGE_TAG = expectedSha.take(12)

                            echo "Candidate deploy SHA: ${expectedSha}"
                        }
                    }
                }

                stage('Checkout Merged Branch') {
                    steps {
                        script {
                            checkout([
                                $class: 'GitSCM',
                                branches: [[name: env.VERIFIED_SHA]],
                                userRemoteConfigs: [[
                                    url: 'https://github.com/Abhi-chintu/fastapi-python-application.git',
                                    refspec: '+refs/heads/jenkins:refs/remotes/origin/jenkins'
                                ]],
                                extensions: [
                                    [$class: 'CleanBeforeCheckout']
                                ]
                            ])

                            def actualSha = sh(
                                script: 'git rev-parse HEAD',
                                returnStdout: true
                            ).trim()

                            def branchSha = sh(
                                script: 'git rev-parse refs/remotes/origin/jenkins',
                                returnStdout: true
                            ).trim()

                            if (!actualSha.equalsIgnoreCase(env.VERIFIED_SHA)) {
                                error('Merged checkout SHA mismatch')
                            }

                            if (!branchSha.equalsIgnoreCase(env.VERIFIED_SHA)) {
                                error(
                                    'Push SHA is not current jenkins branch tip'
                                )
                            }

                            echo "Verified merged SHA: ${actualSha}"
                        }
                    }
                }

                stage('Gitleaks and Pylint') {
                    steps {
                        script {
                            def utils = load 'jenkins/pipeline.groovy'
                            utils.runGitleaks()
                            utils.runPylint()
                        }
                    }
                }

                stage('Docker Build') {
                    steps {
                        script {
                            def utils = load 'jenkins/pipeline.groovy'
                            utils.buildDocker()
                        }
                    }
                }

                stage('Docker Push') {
                    steps {
                        script {
                            def utils = load 'jenkins/pipeline.groovy'
                            utils.pushDocker()
                        }
                    }
                }
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'gitleaks-report.json,pylint-*-report.txt',
                        allowEmptyArchive: true
                    )
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully"
        }

        failure {
            echo "Pipeline failed"
        }
    }
}
