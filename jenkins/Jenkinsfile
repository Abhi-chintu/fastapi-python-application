
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '637423245256'
        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        GATEWAY_REPO = "${ECR_REGISTRY}/demo/gateway"
        PRODUCTS_REPO = "${ECR_REGISTRY}/demo/product"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Determine Build Mode') {
            steps {
                script {
                    env.BUILD_MODE = 'SKIP'

                    if (env.repo_name ==
                        'Abhi-chintu/fastapi-python-application') {

                        if (env.github_event == 'pull_request' &&
                            env.event_action in [
                                'opened', 'reopened', 'synchronize'
                            ] &&
                            env.pr_base == 'jenkins') {

                            env.BUILD_MODE = 'PR_VALIDATION'

                        } else if (
                            env.github_event == 'push' &&
                            env.push_ref == 'refs/heads/jenkins'
                        ) {
                            env.BUILD_MODE = 'MERGED_BRANCH'
                        }
                    }

                    echo "GitHub Event: ${env.github_event ?: 'NOT_SET'}"
                    echo "Event Action: ${env.event_action ?: 'NOT_SET'}"
                    echo "PR Base: ${env.pr_base ?: 'NOT_SET'}"
                    echo "Push Ref: ${env.push_ref ?: 'NOT_SET'}"
                    echo "Build Mode: ${env.BUILD_MODE}"
                }
            }
        }

        stage('Checkout') {
            when {
                expression {
                    env.BUILD_MODE != 'SKIP'
                }
            }
            steps {
                error(
                    'Verified PR/branch checkout must be ' +
                    'configured before enabling builds.'
                )
            }
        }

        stage('Load Pipeline Functions') {
            when {
                expression {
                    env.BUILD_MODE != 'SKIP'
                }
            }
            steps {
                script {
                    pipelineUtils = load 'jenkins/pipeline.groovy'
                }
            }
        }

        stage('Static Analysis') {
            when {
                expression {
                    env.BUILD_MODE in [
                        'PR_VALIDATION',
                        'MERGED_BRANCH'
                    ]
                }
            }
            steps {
                script {
                    pipelineUtils.runGitleaks()
                }
            }
        }

        stage('UT Coverage') {
            when {
                expression {
                    env.BUILD_MODE in [
                        'PR_VALIDATION',
                        'MERGED_BRANCH'
                    ]
                }
            }
            steps {
                script {
                    pipelineUtils.runPylint()
                }
            }
        }

        stage('Docker Build') {
            when {
                expression {
                    env.BUILD_MODE == 'MERGED_BRANCH'
                }
            }
            steps {
                script {
                    pipelineUtils.buildDocker()
                }
            }
        }

        stage('Docker Push') {
            when {
                expression {
                    env.BUILD_MODE == 'MERGED_BRANCH'
                }
            }
            steps {
                script {
                    pipelineUtils.pushDocker()
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'gitleaks-report.json,pylint-*-report.txt',
                allowEmptyArchive: true
            )
        }

        success {
            echo 'Pipeline completed successfully'
        }

        failure {
            echo 'Pipeline failed'
        }
    }
}
