
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '637423245256'

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        GATEWAY_REPO = "${ECR_REGISTRY}/demo/gateway"
        PRODUCTS_REPO = "${ECR_REGISTRY}/demo/product"

        IMAGE_TAG = "${BUILD_NUMBER}"
        BUILD_MODE = 'SKIP'
    }

    stages {

        stage('Determine Build Mode') {
            steps {
                script {
                    env.BUILD_MODE = 'SKIP'

                    if (env.repo_name ==
                        'Abhi-chintu/fastapi-python-application') {

                        if (
                            env.x_github_event == 'pull_request' &&
                            env.event_action in [
                                'opened',
                                'reopened',
                                'synchronize'
                            ] &&
                            env.pr_base == 'jenkins'
                        ) {
                            env.BUILD_MODE = 'PR_VALIDATION'

                        } else if (
                            env.x_github_event == 'push' &&
                            env.push_ref == 'refs/heads/jenkins'
                        ) {
                            env.BUILD_MODE = 'MERGED_BRANCH'
                        }
                    }

                    echo "Event: ${env.x_github_event}"
                    echo "Build Mode: ${env.BUILD_MODE}"
                }
            }
        }

        stage('Checkout') {
            when {
                expression {
                    env.BUILD_MODE != 'SKIP'
                }
            }

            steps {
                script {
                    def expectedSha = ''

                    if (env.BUILD_MODE == 'PR_VALIDATION') {
                        expectedSha = env.pr_sha ?: ''

                    } else {
                        expectedSha = env.push_sha ?: ''
                    }

                    if (!(expectedSha ==~ /^[0-9a-fA-F]{40}$/)) {
                        error('Invalid Git SHA')
                    }

                    def refspec = env.BUILD_MODE == 'PR_VALIDATION'
                        ? '+refs/pull/*/head:refs/remotes/origin/pr/*'
                        : '+refs/heads/jenkins:refs/remotes/origin/jenkins'

                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: expectedSha]],
                        userRemoteConfigs: [[
                            url: 'https://github.com/Abhi-chintu/fastapi-python-application.git',
                            refspec: refspec
                        ]],
                        extensions: [
                            [$class: 'CleanBeforeCheckout']
                        ]
                    ])

                    def actualSha = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    if (!actualSha.equalsIgnoreCase(expectedSha)) {
                        error('Git checkout SHA mismatch')
                    }

                    if (env.BUILD_MODE == 'MERGED_BRANCH') {
                        def branchSha = sh(
                            script: 'git rev-parse refs/remotes/origin/jenkins',
                            returnStdout: true
                        ).trim()

                        if (!branchSha.equalsIgnoreCase(expectedSha)) {
                            error('Commit is not current jenkins branch tip')
                        }
                    }

                    echo "Verified SHA: ${actualSha}"
                }
            }
        }

        stage('Load Functions') {
            when {
                expression {
                    env.BUILD_MODE != 'SKIP'
                }
            }

            steps {
                script {
                    pipelineUtils = load 'jenkins/pipeline.groovy'
                }
            }
        }

        stage('Gitleaks') {
            when {
                expression {
                    env.BUILD_MODE != 'SKIP'
                }
            }

            steps {
                script {
                    pipelineUtils.runGitleaks()
                }
            }
        }

        stage('Pylint') {
            when {
                expression {
                    env.BUILD_MODE != 'SKIP'
                }
            }

            steps {
                script {
                    pipelineUtils.runPylint()
                }
            }
        }

        stage('Docker Build') {
            when {
                expression {
                    env.BUILD_MODE == 'MERGED_BRANCH'
                }
            }

            steps {
                script {
                    pipelineUtils.buildDocker()
                }
            }
        }

        stage('Docker Push') {
            when {
                expression {
                    env.BUILD_MODE == 'MERGED_BRANCH'
                }
            }

            steps {
                script {
                    pipelineUtils.pushDocker()
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'gitleaks-report.json,pylint-*-report.txt',
                allowEmptyArchive: true
            )
        }

        success {
            echo 'Pipeline completed successfully'
        }

        failure {
            echo 'Pipeline failed'
        }
    }
}
